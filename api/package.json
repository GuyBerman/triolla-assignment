{
  "name": "squanchy-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fridge temperature monitoring API for Squanchy Bakery",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx scripts/seed.ts",
    "generate": "tsx scripts/generateData.ts",
    "migrate:up": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "migrate:create": "node-pg-migrate create -j ts -m migrations",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "express": "^4.21.2",
    "multer": "^2.0.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
